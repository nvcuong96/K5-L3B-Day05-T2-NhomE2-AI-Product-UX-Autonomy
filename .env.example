# Sao chép file này thành .env rồi dán API key mới từ Google AI Studio.
# Backend chỉ yêu cầu key là chuỗi không rỗng, không phụ thuộc tiền tố hay độ dài key.
GEMINI_API_KEY=paste_your_new_gemini_api_key_here

# Model Flash Lite chạy ổn định với project Free trong lần kiểm thử gần nhất.
GEMINI_MODEL=gemini-3.5-flash-lite

PORT=3000

